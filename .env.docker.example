# Generate safe local values with:
#   python scripts/create_env.py --profile docker
# Do not commit the generated .env file.
COMPOSE_PROJECT_NAME=eci_capstone
ENVIRONMENT=development
LOG_LEVEL=INFO

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=eci
MYSQL_APP_USER=eci_app
MYSQL_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
POWERBI_USER=eci_powerbi
POWERBI_PASSWORD=CHANGE_ME_POWERBI_PASSWORD
DATABASE_URL=mysql+pymysql://eci_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:3306/eci?charset=utf8mb4

VECTOR_BACKEND=weaviate
WEAVIATE_MODE=local
WEAVIATE_URL=http://127.0.0.1:8080
WEAVIATE_USER=eci-root
WEAVIATE_API_KEY=CHANGE_ME_WEAVIATE_API_KEY
WEAVIATE_COLLECTION=ComplaintNarrative

# Keep these local for a zero-cost first run. Change both to openai after
# adding a real API key below.
EMBEDDING_BACKEND=local
ANSWER_BACKEND=local
LOCAL_EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

HMAC_SECRET=CHANGE_ME_HMAC_SECRET_AT_LEAST_32_CHARACTERS
PII_REDACTION_ENABLED=true
STORE_REJECTED_ROWS_IN_DATABASE=true
AUDIT_USER_QUERIES=false
MAX_INPUT_FILE_MB=25
MAX_INPUT_ROWS=100000
MAX_QUERY_CHARACTERS=500
DEFAULT_TOP_K=5
MAX_TOP_K=10
MAX_CONTEXT_CHARACTERS=24000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
